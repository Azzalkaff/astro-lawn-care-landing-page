---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import Header from '../components/islands/Header';
import Footer from '../components/ui/Footer.astro';
import TestimonialCarousel from '../components/islands/TestimonialCarousel';
import BeforeAfterSlider from '../components/islands/BeforeAfterSlider';
import AppointmentForm from '../components/islands/AppointmentForm';
import FaqAccordion from '../components/islands/FaqAccordion';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order).slice(0, 4);

const testimonialsCollection = await getCollection('testimonials');
const testimonials = testimonialsCollection.map(t => ({ id: t.id, ...t.data }));

const faqCollection = await getCollection('faq');
const faqs = faqCollection
  .sort((a, b) => a.data.order - b.data.order)
  .map(f => ({ id: f.id, ...f.data }));
---

<BaseLayout>
  <Header client:load />
  
  <HeroSection 
    title="Professional Lawn Care for a Perfect Yard"
    subtitle="We provide reliable, high-quality lawn maintenance and landscaping services across Brisbane. Let us handle the hard work while you enjoy a beautiful outdoor space."
  />

  <!-- Trust Badges -->
  <section class="border-y border-slate-200 bg-slate-50 py-8">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-y-8 gap-x-8 sm:grid-cols-4 sm:gap-x-12 text-center text-sm font-semibold leading-6 text-slate-700">
        <div class="flex flex-col items-center justify-center gap-3">
          <div class="p-3 bg-white rounded-full shadow-sm ring-1 ring-slate-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <span>Fully Insured & Licensed</span>
        </div>
        <div class="flex flex-col items-center justify-center gap-3">
          <div class="p-3 bg-white rounded-full shadow-sm ring-1 ring-slate-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
            </svg>
          </div>
          <span>5-Star Local Experts</span>
        </div>
        <div class="flex flex-col items-center justify-center gap-3">
          <div class="p-3 bg-white rounded-full shadow-sm ring-1 ring-slate-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
            </svg>
          </div>
          <span>Eco-Friendly Products</span>
        </div>
        <div class="flex flex-col items-center justify-center gap-3">
          <div class="p-3 bg-white rounded-full shadow-sm ring-1 ring-slate-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
            </svg>
          </div>
          <span>100% Satisfaction Guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="py-24 sm:py-32 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Our Services</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Everything you need to keep your property looking its best, year-round.
        </p>
      </div>
      <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-4">
        {sortedServices.map(service => (
          <ServiceCard
            title={service.data.title}
            description={service.data.description}
            image={service.data.image}
            href={`/services/${service.id}`}
          />
        ))}
      </div>
      <div class="mt-16 text-center">
        <a href="/services" class="text-sm font-semibold leading-6 text-primary-600 hover:text-primary-500">
          View all services <span aria-hidden="true">â†’</span>
        </a>
      </div>
    </div>
  </section>

  <section id="about" class="bg-primary-900 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:text-center">
        <h2 class="text-base font-semibold leading-7 text-primary-400">Our Process</h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Simple, transparent, and reliable
        </p>
      </div>
      <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
        <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-3 lg:gap-y-16">
          <div class="relative pl-16">
            <dt class="text-base font-semibold leading-7 text-white">
              <div class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500">
                <span class="text-primary-950 font-bold">1</span>
              </div>
              Get a Quote
            </dt>
            <dd class="mt-2 text-base leading-7 text-primary-100">Contact us with your requirements and we'll provide a transparent, no-obligation quote.</dd>
          </div>
          <div class="relative pl-16">
            <dt class="text-base font-semibold leading-7 text-white">
              <div class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500">
                <span class="text-primary-950 font-bold">2</span>
              </div>
              Schedule Service
            </dt>
            <dd class="mt-2 text-base leading-7 text-primary-100">Choose a time that works for you. We offer flexible scheduling, including regular maintenance plans.</dd>
          </div>
          <div class="relative pl-16">
            <dt class="text-base font-semibold leading-7 text-white">
              <div class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500">
                <span class="text-primary-950 font-bold">3</span>
              </div>
              Enjoy Your Lawn
            </dt>
            <dd class="mt-2 text-base leading-7 text-primary-100">Our professionals will handle the work efficiently, leaving you with a perfect outdoor space to enjoy.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="gallery" class="py-24 sm:py-32 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:text-center mb-16">
        <h2 class="text-base font-semibold leading-7 text-primary-600">Real Results</h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          See the Difference
        </p>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Slide to see how we transformed this overgrown yard into a beautiful, healthy lawn.
        </p>
      </div>
      
      <BeforeAfterSlider 
        client:visible 
        beforeImage="/images/before-lawn.png" 
        afterImage="/images/after-lawn.png" 
      />
    </div>
  </section>

  <TestimonialCarousel client:visible testimonials={testimonials} />

  <section id="faq" class="py-24 sm:py-32 bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:text-center mb-16">
        <h2 class="text-base font-semibold leading-7 text-primary-600">FAQ</h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Frequently Asked Questions
        </p>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Have a question about our services? Find your answer below.
        </p>
      </div>
      
      <FaqAccordion client:visible faqs={faqs} />
    </div>
  </section>

  <section id="appointment" class="relative bg-white py-24 sm:py-32 overflow-hidden border-t border-slate-200">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1558904541-efa843a96f09?q=80&w=2000&auto=format&fit=crop')] opacity-[0.03] bg-cover bg-center grayscale"></div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-xl">
        <h2 class="text-base font-semibold leading-8 text-primary-600">Ready to get started?</h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Schedule your service today</p>
        <p class="mt-6 text-lg leading-8 text-slate-600">
          Whether you need a one-time cleanup or regular maintenance, our team is ready to help. Book an appointment online and we'll confirm within 24 hours.
        </p>
        
        <div class="mt-10">
          <h3 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-primary-600">
              <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
            </svg>
            Service Areas
          </h3>
          <p class="mt-2 text-slate-600">We proudly provide our services across the Greater Brisbane Area, including:</p>
          <ul class="mt-4 grid grid-cols-2 gap-4 text-sm leading-6 text-slate-600">
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-primary-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Brisbane CBD & Inner City
            </li>
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-primary-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              North Brisbane
            </li>
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-primary-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              South Brisbane
            </li>
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-primary-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Eastern Suburbs
            </li>
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-primary-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Western Suburbs
            </li>
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-primary-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Logan & Surrounds
            </li>
          </ul>
        </div>
      </div>
      <div class="mx-auto mt-16 max-w-2xl lg:mx-0 lg:mt-0 lg:max-w-none lg:absolute lg:right-8 lg:top-1/2 lg:-translate-y-1/2 lg:w-1/2">
        <div class="lg:pl-16">
          <AppointmentForm client:visible />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
