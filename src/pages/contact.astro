---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/islands/Header';
import Footer from '../components/ui/Footer.astro';
import ContactForm from '../components/islands/ContactForm';
---

<BaseLayout title="Contact Us - EverGreen Lawn Care">
  <Header client:load />
  
  <div class="bg-slate-900 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl mt-16">Contact Us</h1>
      <p class="mt-6 text-lg leading-8 text-slate-300 max-w-2xl mx-auto">
        Get in touch with us for a free quote or to ask any questions about our services. We're here to help!
      </p>
    </div>
  </div>

  <section class="py-24 sm:py-32 bg-white relative">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:max-w-4xl grid grid-cols-1 lg:grid-cols-2 gap-16">
        
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Get a Free Quote</h2>
          <p class="text-slate-600 mb-8">
            Fill out the form below and we'll get back to you within 24 hours with a customized quote for your property.
          </p>
          <ContactForm client:load />
        </div>
        
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Contact Information</h2>
          <dl class="space-y-6 text-slate-600">
            <div class="flex gap-x-4">
              <dt class="flex-none">
                <span class="sr-only">Address</span>
                <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-primary-50 text-primary-600">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                </div>
              </dt>
              <dd class="flex items-center">
                <p>123 Green Ave<br />Brisbane QLD 4000</p>
              </dd>
            </div>
            
            <div class="flex gap-x-4">
              <dt class="flex-none">
                <span class="sr-only">Telephone</span>
                <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-primary-50 text-primary-600">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.25-3.95-6.847-6.847l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                  </svg>
                </div>
              </dt>
              <dd class="flex items-center">
                <a class="hover:text-primary-600" href="tel:0400000000">0400 000 000</a>
              </dd>
            </div>
            
            <div class="flex gap-x-4">
              <dt class="flex-none">
                <span class="sr-only">Email</span>
                <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-primary-50 text-primary-600">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
              </dt>
              <dd class="flex items-center">
                <a class="hover:text-primary-600" href="mailto:hello@evergreen.com.au">hello@evergreen.com.au</a>
              </dd>
            </div>
          </dl>
        </div>
        
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
